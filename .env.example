# Firebase keys are generated by `flutterfire configure` — not listed here.
# See lib/firebase_options.dart after running flutterfire configure.

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset

# Google AI Studio — Gemini recommendations
GEMINI_API_KEY=your_gemini_api_key

# OpenWeatherMap — weather widget
OPENWEATHER_API_KEY=your_openweather_api_key

# Razorpay — test mode only
RAZORPAY_KEY_ID=rzp_test_your_key_id

# data.gov.in / eNAM — mandi prices
MANDI_API_KEY=your_mandi_api_key
